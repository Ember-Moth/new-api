# Copy to .env.host; never commit the filled file.
# Match NEW_API_IMAGE_TAG to the VERSION file before building.
NEW_API_IMAGE_TAG=local
# uname -m: x86_64 -> amd64, aarch64/arm64 -> arm64
TARGETARCH=amd64

# The host must listen on an address reachable from new-api-app-net.
# URL-encode credentials inside DSNs. Single quotes prevent Compose $ expansion.
# Use your PostgreSQL TLS settings when TLS is required.
SQL_DSN='postgresql://new_api:REPLACE_ME@172.30.80.1:5432/new_api?sslmode=disable'
LOG_SQL_DSN='clickhouse://new_api:REPLACE_ME@172.30.80.1:9000/new_api_logs'
REDIS_CONN_STRING='redis://:REPLACE_ME@172.30.80.1:6379/0'

# Generate each once with openssl rand -hex 32; retain across redeployments.
SESSION_SECRET=
CRYPTO_SECRET=
SESSION_COOKIE_TRUSTED_URL=https://api.example.com
TRUSTED_PROXIES=172.30.80.1/32

# Per process and per database pool; account for both application planes.
SQL_MAX_OPEN_CONNS=20
SQL_MAX_IDLE_CONNS=5
